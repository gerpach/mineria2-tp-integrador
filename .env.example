# Copiar a .env (está en .gitignore, NUNCA se versiona) y completar. El pipeline lo lee solo.
# Serving en AstraDB:
CASSANDRA_MODE=astra
ASTRA_BUNDLE_PATH=/ruta/secure-connect-<base>.zip
# Opción A (recomendada): token de aplicación generado en la consola de Astra
ASTRA_TOKEN=AstraCS:xxxxxxxx
# Opción B: par client id / secret del mismo token
# ASTRA_CLIENT_ID=
# ASTRA_CLIENT_SECRET=
ASTRA_KEYSPACE=cloud_analytics
# Solo para la carga por Data API (src/jobs/serving_astra_api.py):
ASTRA_DB_ID=<id-de-la-base>
ASTRA_REGION=us-east-2
# Datos completos (opcional):
# LANDING_DIR=/ruta/datalake/landing
# LAKE_ROOT=/ruta/datalake
